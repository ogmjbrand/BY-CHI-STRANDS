# BY CHI STRANDS — environment template
#
# Copy to .env.local for local development and fill in real values there.
# .env.local is gitignored. This file lists names only and must never be
# given real values.
#
# For production, these are set in the Vercel project:
#   Vercel dashboard -> by-chi-strands -> Settings -> Environment Variables
# Anything set there is available to the server at runtime and is never
# exposed to the browser unless its name begins with NEXT_PUBLIC_.


# ── Payments ────────────────────────────────────────────────────────────
#
# Flutterwave Standard. Found in the Flutterwave dashboard under
# Settings -> API Keys. Use the test key (FLWSECK_TEST-...) against the test
# dashboard, and the live key (FLWSECK-...) only in production.
#
# THIS IS A SECRET. It authorises charges against the ByChi account.
#   - Set it in Vercel yourself. Do not paste it into a chat, a commit, a
#     support ticket, or a screenshot.
#   - Never give it a NEXT_PUBLIC_ prefix. That prefix tells Next.js to
#     inline the value into the JavaScript bundle sent to every visitor.
#   - src/lib/flutterwave.ts is marked `server-only`, so importing it from a
#     client component fails the build rather than leaking the key.
#
# Until this is set, /api/payments/flutterwave/initiate returns 503 and
# checkout offers the concierge flow instead. Nothing breaks; card payment is
# simply unavailable. Set it in Vercel for Production, Preview and
# Development, then redeploy — environment changes do not apply to existing
# deployments.
FLUTTERWAVE_SECRET_KEY=


# ── Database ────────────────────────────────────────────────────────────
#
# Supabase project settings -> API. The URL and anon key are public by
# design (the anon key is constrained by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security entirely — treat it like a database
# password. Server-side only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ── Transactional email ─────────────────────────────────────────────────
#
# SECRET. Resend dashboard -> API Keys. Sends order confirmations and
# shipping notifications. Server-side only.
RESEND_API_KEY=


# ── Site ────────────────────────────────────────────────────────────────
#
# Absolute origin, no trailing slash. Used to build links in emails and the
# canonical URLs in sitemap.xml, so it must be the real public domain in
# production (e.g. https://bychistrands.com) rather than a preview URL.
NEXT_PUBLIC_SITE_URL=
